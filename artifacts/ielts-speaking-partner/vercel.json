{
  "installCommand": "cd ../.. && npm install --legacy-peer-deps || true",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "build": {
    "env": {
      "PORT": "3000",
      "BASE_PATH": "/"
    }
  },
  "functions": {
    "api/transcribe.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/gemini/chat.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
